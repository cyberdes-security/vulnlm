# First run: bash scripts/install.sh (creates .env if absent). No host Ollama is required.
# Docker Compose values. Keep every exposed lab port bound to loopback.
LAB_PORT=8000
# The attacker's external site (tool-result-injection); pages are published here with PUT.
SITE_PORT=8001
LLM_MODEL=qwen2.5:3b

# Ollama behind the model gateway. Empty uses bundled Ollama.
# Installer auto-selects verified NVIDIA Docker access on Linux/WSL2, otherwise CPU.
# bash scripts/install.sh --gpu cpu forces CPU; --gpu nvidia requires GPU access.
# http://host.docker.internal:11434 opts into this computer's running Ollama (GPU).
# Missing active/image models download through the gateway. Host Ollama must be reachable.
OLLAMA_URL=

# Empty disables HTTP reset. Prefer the explicit CLI reset command in README.
LAB_RESET_TOKEN=
# Native development: set these explicitly in your shell (see README).
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/new-lab.sqlite3
# DATA_DIR=/absolute/path/to/disposable-lab-data
# LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions

# Optional image model for /chat/image. Empty: image chat uses the active model when it accepts images.
VISION_MODEL=

# Exact public lab URLs permitted by the HTTP tool in protected mode.
# SAFE_HTTP_URLS=["http://internal-service:9000/public","http://cyberdes-vulnerable-cloud.example/status"]
